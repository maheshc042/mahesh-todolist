# ---------------------------------------------------------------------------
# Copy to .env (agent) — never commit the filled-in version.
# On Vercel these same values live in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Naukri accounts -------------------------------------------------------
# One account == one resume: Naukri attaches whatever CV sits on the PROFILE,
# there is no per-application resume picker. Two job families need two logins.
#
# Account 1 "primary" -> the Full Stack / MERN + AI resume.
NAUKRI_EMAIL=fullstack-account@example.com
NAUKRI_PASSWORD=your-naukri-password

# Account 2 "secondary" -> the AI / Python Engineer resume. Optional: leave both
# blank and `run --all-accounts` / `schedule` skip this account with a warning
# instead of failing.
NAUKRI_EMAIL_2=ai-python-account@example.com
NAUKRI_PASSWORD_2=your-second-naukri-password

# Which account a bare `run` (no -a flag) targets: primary | secondary
DEFAULT_ACCOUNT=primary

# --- Database (required) ---------------------------------------------------
# Neon pooled connection string. Provided automatically by the Neon
# integration; the agent strips libpq-only params for asyncpg.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_SCHEMA=naukri
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Telegram notifications (optional) ------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths (optional overrides) -------------------------------------------
CONFIG_PATH=config/config.yaml
ARTIFACTS_DIR=artifacts
LOG_DIR=logs
RESUME_DIR=resumes

# --- Runtime knobs (optional) ---------------------------------------------
# HEADLESS=false forces a visible browser (needs a display / X server).
HEADLESS=true
LOG_LEVEL=INFO
LOG_JSON=false
DRY_RUN=false
