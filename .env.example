# ---------------------------------------------------------------------------
# Copy to .env (agent) — never commit the filled-in version.
# On Vercel these same values live in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Naukri accounts -------------------------------------------------------
# One account == one resume: Naukri attaches whatever CV sits on the PROFILE,
# there is no per-application resume picker. Two job families need two logins.
#
# Account 1 "primary" -> the Full Stack / MERN + AI resume.
NAUKRI_EMAIL=fullstack-account@example.com
NAUKRI_PASSWORD=your-naukri-password

# Account 2 "secondary" -> the AI / Python Engineer resume. Optional: leave both
# blank and `run --all-accounts` / `schedule` skip this account with a warning
# instead of failing.
NAUKRI_EMAIL_2=ai-python-account@example.com
NAUKRI_PASSWORD_2=your-second-naukri-password

# Which account a bare `run` (no -a flag) targets: primary | secondary
DEFAULT_ACCOUNT=primary

# --- Multi-platform accounts (optional overrides if different from NAUKRI_EMAIL) ---
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=
CUTSHORT_EMAIL=
CUTSHORT_PASSWORD=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Session cookie for the LinkedIn cold-email campaign. Optional — the
# recommended flow is `python -m naukri_agent login-linkedin` (manual headed
# login, saved to artifacts/linkedin_chrome_profile), which this cookie
# complements only when the profile has no session yet.
LINKEDIN_LI_AT=
# Optional: pair with LINKEDIN_LI_AT if you export cookies manually.
LINKEDIN_JSESSIONID=


# --- Database (required) ---------------------------------------------------
# Neon pooled connection string. Provided automatically by the Neon
# integration; the agent strips libpq-only params for asyncpg.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_SCHEMA=naukri
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# Development-only escape hatch for self-signed local Postgres certificates.
# Never enable this for Neon or another managed database.
DB_SSL_INSECURE=false
# Required: at least 32 random characters. Rotating it invalidates stored browser
# sessions, so preserve it in the server's secret manager and back it up safely.
BROWSER_SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Telegram notifications (optional) ------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths (optional overrides) -------------------------------------------
CONFIG_PATH=config/config.yaml
ARTIFACTS_DIR=artifacts
LOG_DIR=logs
RESUME_DIR=resumes

# --- Cold Outreach & AI Copywriting ---------------------------------------
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_letter_app_password
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --- Runtime knobs (optional) ---------------------------------------------
# HEADLESS=false forces a visible browser (needs a display / X server).
HEADLESS=true
LOG_LEVEL=INFO
LOG_JSON=false
DRY_RUN=false
# Emergency external-mutation kill switch. Set false to block submissions and
# profile edits regardless of CLI flags.
SIDE_EFFECTS_ENABLED=true
# Keep false until matched-outreach scoring and suppression gates are validated.
MATCHED_OUTREACH_ENABLED=false
